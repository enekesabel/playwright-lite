diff --git a/src/closedShadowRoots.ts b/src/closedShadowRoots.ts
new file mode 100644
index 0000000..cecd493
--- /dev/null
+++ b/src/closedShadowRoots.ts
@@ -0,0 +1,61 @@
+/**
+ * THROWAWAY PROTOTYPE for #259, not production code.
+ *
+ * Wraps `Element.prototype.attachShadow` when this module is evaluated and
+ * keeps each closed root it sees in a module-private WeakMap, so input
+ * (hit-testing and keyboard focus) can descend into it. Locators, ARIA
+ * snapshots and every other page-state path never read this map.
+ *
+ * An action whose target element sits inside closed roots also records each
+ * root on the way up from it, since holding the element already reaches them.
+ *
+ * The wrapper is permanent: a root attached while it is absent is lost for
+ * good, so it cannot follow the install-on-subscription, restore-on-dispose
+ * rule for host globals.
+ */
+const closedRoots = new WeakMap<Element, ShadowRoot>();
+
+function install() {
+  const proto = globalThis.Element?.prototype;
+  if (!proto) return;
+  const descriptor = Object.getOwnPropertyDescriptor(proto, "attachShadow");
+  const original = descriptor?.value as
+    | ((this: Element, init: ShadowRootInit) => ShadowRoot)
+    | undefined;
+  if (typeof original !== "function") return;
+  const wrapper = new Proxy(original, {
+    apply(target, thisArg: Element, args: [ShadowRootInit]) {
+      const root = Reflect.apply(target, thisArg, args) as ShadowRoot;
+      if (root.mode === "closed") closedRoots.set(thisArg, root);
+      return root;
+    },
+  });
+  try {
+    Object.defineProperty(proto, "attachShadow", {
+      ...descriptor,
+      value: wrapper,
+    });
+  } catch {
+    // A frozen or non-configurable prototype keeps the native method.
+  }
+}
+
+install();
+
+/** The host's shadow root, open or known closed; `null` when out of reach. */
+export function inputShadowRoot(host: Element): ShadowRoot | null {
+  return host.shadowRoot ?? closedRoots.get(host) ?? null;
+}
+
+/** Records every closed root enclosing `element`, then returns it. */
+export function learnClosedRoots<T extends Element>(element: T): T {
+  for (
+    let root = element.getRootNode();
+    root.nodeType === 11 && (root as ShadowRoot).host;
+    root = (root as ShadowRoot).host.getRootNode()
+  ) {
+    const shadow = root as ShadowRoot;
+    if (shadow.mode === "closed") closedRoots.set(shadow.host, shadow);
+  }
+  return element;
+}
